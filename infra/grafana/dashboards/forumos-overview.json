{
  "title": "ForumOS — Overview",
  "uid": "forumos-overview",
  "tags": ["forumos"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "API latency p95",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total[5m])) by (status)", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx" }]
    },
    {
      "type": "timeseries",
      "title": "WebSocket connections",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "ws_connections", "legendFormat": "open" }]
    },
    {
      "type": "timeseries",
      "title": "Celery queue length",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "celery_queue_length", "legendFormat": "{{queue}}" }]
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "kafka_consumer_group_lag", "legendFormat": "{{group}}" }]
    }
  ]
}
