# ─────────────────────────────────────────────────────────────
# ForumOS — пример переменных окружения
# Скопируйте в .env и заполните: cp .env.example .env
# Генерация секретов: make secrets
# ─────────────────────────────────────────────────────────────

# ── Общие ───────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-with-make-secrets
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
APP_VERSION=1.0.0
APP_HOST=http://localhost:8080
LOG_LEVEL=INFO

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=forumos
POSTGRES_USER=forumos
POSTGRES_PASSWORD=change-me-postgres

# ── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis

# ── Kafka ───────────────────────────────────────────────────
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_AUTO_CREATE_TOPICS=false
KAFKA_PARTITIONS=3

# ── Elasticsearch ──────────────────────────────────────────
ELASTIC_PASSWORD=change-me-elastic
ELASTIC_URL=http://elasticsearch:9200

# ── MinIO (S3-совместимое хранилище) ───────────────────────
MINIO_ROOT_USER=forumos
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=forumos-media

# ── Секреты приложения ─────────────────────────────────────
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_SIGNING_KEY=change-me-jwt-signing-key
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# ── Email (SMTP; для dev — консольный backend) ─────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=no-reply@forumos.local

# ── Наблюдаемость ──────────────────────────────────────────
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ── CORS / CSRF ────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
